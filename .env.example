# Resend API key — https://resend.com/api-keys (put the real value in .env.local, never here)
RESEND_API_KEY=
# Where messages are delivered. Empty = the email from src/content/site.ts
CONTACT_TO_EMAIL=
# Sender. Until a domain is verified in Resend, use the test sender below
# (it can only deliver to the email of your Resend account).
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Public URL of the site (canonical, Open Graph). Optional on Vercel: the production URL is
# detected automatically. Set it when a custom domain is connected, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
